# Copy to ".env" and fill values. Do NOT commit ".env".
#
# Git Bash:
#   cp env_configuration .env

# HTTP
HTTP_ADDR=:8080

# MySQL
# Format: user:password@tcp(host:port)/db_name?parseTime=true
MYSQL_DSN=root:CHANGE_ME@tcp(localhost:3306)/app_db?parseTime=true

# MySQL pool tuning (optional)
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=25
MYSQL_CONN_MAX_LIFETIME=5m

